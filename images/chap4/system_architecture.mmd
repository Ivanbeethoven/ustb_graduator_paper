graph TB
    %% Nodes
    subgraph ClientLayer ["展现层 (Presentation Layer)"]
        direction TB
        Browser["Web 浏览器"]
        subgraph SPA ["单页应用 (Vue3)"]
            Views["视图组件"]
            Store["状态管理 (Pinia)"]
            Charts["可视化图表 (ECharts)"]
        end
    end

    subgraph ServiceLayer ["服务层 (Service Layer)"]
        direction TB
        API["REST API 网关 (Flask)"]
        Scheduler["任务调度器"]
        
        subgraph Logic ["核心业务逻辑"]
            cve_mgr["CVE 管理"]
            strategy_mgr["策略生成"]
            review_mgr["评审控制"]
        end
    end

    subgraph EngineLayer ["智能引擎层 (Intelligence Layer)"]
        direction TB
        Agent["KPEAgent 核心"]
        RAG["RAG 检索器"]
        CoT["CoT 推理机"]
    end

    subgraph DataLayer ["数据层 (Data Layer)"]
        direction TB
        FileDB[("文件存储\n(JSON/CSV)")]
        VectorDB[("向量索引")]
    end

    %% Relationships
    Browser <-->|HTTP/JSON| API
    Views -.-> Store
    API --> Scheduler
    Scheduler --> Logic
    strategy_mgr <--> Agent
    Agent --> RAG
    Agent --> CoT
    
    Logic --> FileDB
    RAG -.-> VectorDB