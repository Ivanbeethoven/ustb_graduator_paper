flowchart LR
    %% 数据流图 (DFD Level-1) — KPEAgent 防控闭环（横向）
    classDef process fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px,color:#000
    classDef store fill:#e8eaf6,stroke:#283593,stroke-width:2px,color:#000
    classDef entity fill:#bbdefb,stroke:#1565c0,stroke-width:2px,color:#000

    %% 外部实体
    User["安全工程师"]:::entity
    Expert["专家评审员"]:::entity

    %% 数据存储
    D1[("D1 · CVE 知识库")]:::store
    D2[("D2 · 策略库")]:::store
    D3[("D3 · 审计日志")]:::store

    %% 处理过程
    P1("P1 漏洞载入\n与特征提取"):::process
    P2("P2 策略生成\n(RAG + CoT)"):::process
    P3("P3 人工评审\n与反馈"):::process
    P4("P4 策略排序\n与选型"):::process
    P5("P5 审计归档"):::process

    %% 数据流
    User -->|"CVE 原始数据"| P1
    P1 -->|"结构化特征"| D1
    D1 -.->|"检索语料"| P2
    P1 -->|"分析请求"| P2
    P2 -->|"候选策略集"| D2

    D2 -.->|"待审策略"| P3
    Expert -->|"评审意见"| P3
    P3 -->|"修订反馈"| P2

    P3 -->|"通过策略"| P4
    Expert -->|"排序偏好"| P4
    P4 -->|"最终排名"| P5
    P5 -->|"决策记录"| D3