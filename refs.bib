  issn     = {1939-3520},
  keywords = {Software; Training; Biological system modeling; Codes; Software quality; Large language models; Source coding; Software systems; Software engineering; Nickel; Software vulnerability analysis; large language model},
  abstract = {This paper proposes a pipeline for quantitatively evaluating interactive Large Language Models (LLMs) using publicly available datasets. We carry out an extensive technical evaluation of LLMs using Big-Vul covering four different common software vulnerability tasks. This evaluation assesses the multi-tasking capabilities of LLMs based on this dataset. We find that the existing state-of-the-art approaches and pre-trained Language Models (LMs) are generally superior to LLMs in software vulnerability detection. However, in software vulnerability assessment and location, certain LLMs (e.g., CodeLlama and WizardCoder) have demonstrated superior performance compared to pre-trained LMs, and providing more contextual information can enhance the vulnerability assessment capabilities of LLMs. Moreover, LLMs exhibit strong vulnerability description capabilities, but their tendency to produce excessive output significantly weakens their performance compared to pre-trained LMs. Overall, though LLMs perform well in some aspects, they still need improvement in understanding the subtle differences in code vulnerabilities and the ability to describe vulnerabilities to fully realize their potential. Our evaluation pipeline provides valuable insights into the capabilities of LLMs in handling software vulnerabilities.}
}

@misc{malul2024genkubesec,
  author        = {Ehud Malul and Yair Meidan and Dudu Mimran and Yuval Elovici and Asaf Shabtai},
  title         = {{GenKubeSec}: {LLM}-based {Kubernetes} misconfiguration detection, localization, reasoning, and remediation},
  mark          = {EB/OL},
  year          = {2024},
  eprint        = {2405.19954},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CR},
  doi           = {10.48550/arXiv.2405.19954},
  urldate       = {2026-04-01},
  url           = {https://arxiv.org/abs/2405.19954},
  abstract      = {Kubernetes configuration files are often highly complex and error-prone, leading to security vulnerabilities and operational setbacks. Existing rule-based tools rely on static rule sets and are limited in their ability to detect newly discovered misconfigurations, while recent remediation approaches often suffer from limited scalability, restricted coverage, or high expertise requirements. This paper proposes GenKubeSec, an adaptive LLM-based method that detects a wide variety of Kubernetes misconfigurations, identifies their exact locations, provides detailed reasoning, and suggests remediation actions. Experimental results show strong precision and recall compared with industry-standard tools, while expert examination indicates that its explanations, localization, and remediation guidance are highly informative and useful.}
}

@article{minna2025helmllm,
  author  = {Francesco Minna and Fabio Massacci and Katja Tuma},
  title   = {Analyzing and mitigating (with {LLMs}) the security misconfigurations of {Helm} charts from {Artifact Hub}},
  journal = {Empirical Software Engineering},
  year    = {2025},
  volume  = {30},
  number  = {5},
  pages   = {132},
  doi     = {10.1007/s10664-025-10688-0},
  abstract = {Helm is a widely used package manager for Kubernetes, and Helm charts describe the dependencies, resources, and parameters required to deploy applications in Kubernetes clusters. This study empirically analyzes the security misconfigurations of Helm charts from Artifact Hub, compares the performance of existing analysis tools, and evaluates the extent to which large language models can be used to mitigate these misconfigurations. The proposed pipeline analyzes charts with state-of-the-art open-source tools, uses LLMs to suggest mitigations for each detected issue, and re-analyzes the refactored charts to assess whether the fixes satisfy security policies. The results show significant differences between LLMs, highlight the importance of providing sufficient configuration context, and note that even correct fixes may delete unrelated configurations and thus affect application functionality.}
}

@article{konstantaras2026edrrules,
  author    = {Ioannis Konstantaras and Efstratios Chatzoglou and Konstantinos E. Kampourakis and Georgios Kambourakis},
  title     = {Evaluating {LLMs} for the automated generation of operational detection rules in enterprise {EDR} environments},
  journal   = {Electronics},
  year      = {2026},
  volume    = {15},
  number    = {10},
  pages     = {2088},
  doi       = {10.3390/electronics15102088},
  abstract  = {The integration of Large Language Models (LLMs) into cybersecurity operations has garnered significant attention, particularly in automating the creation of detection rules for Endpoint Detection and Response (EDR) systems. However, the practical efficacy of these AI-generated rules in real-world enterprise environments remains under-explored. This paper presents a systematic evaluation of state-of-the-art LLMs in generating operational, syntactically correct, and high-fidelity detection rules for enterprise EDR platforms. We curate a diverse dataset of real-world attack scenarios and evaluate the models based on criteria such as syntax validity, detection accuracy, false positive minimization, and adherence to enterprise rule-writing best practices. Our findings reveal the strengths and critical limitations of current LLMs in this specialized domain, identifying gaps in domain knowledge, context awareness, and the ability to handle complex, multi-stage attack patterns. We further provide insights and recommendations for refining LLM prompts and architectures to improve the reliability and deployability of automatically generated security rules in production EDR environments.}
}

@article{alsabbagh2026autosecagent,
  author  = {Abdallah Al-Sabbagh and Eddy Abdo and Khouloud Samrouth and Ahmad A. A. Alkhatib and Mahmoud Elkhodr},
  title   = {{AutoSecAgent}: A semi-automated {AI}-driven penetration testing framework through recursive memory and real-time {RAG}},
  journal = {The Journal of Supercomputing},
  year    = {2026},
  volume  = {82},
  number  = {5},
  articleno = {318},
  doi     = {10.1007/s11227-026-08439-z},
  abstract = {Manual penetration testing is increasingly inadequate against rapidly evolving cyber threats because it is time-consuming, difficult to scale, and heavily reliant on human expertise. This paper introduces AutoSecAgent, an AI-driven platform for semi-automated end-to-end penetration testing that covers vulnerability discovery, exploitation, reporting, and remediation guidance under human oversight. Built on an agent orchestration framework and powered by a cybersecurity-focused large language model, the system incorporates recursive memory to preserve context across multi-step attack chains and real-time retrieval-augmented generation to access up-to-date vulnerability information. Experimental results indicate improved performance over representative LLM-based baselines in controlled evaluation settings.}
}
@inproceedings{ghosh2025cve,
  title={{CVE-LLM}: Ontology-assisted automatic vulnerability evaluation using large language models},
  author={Ghosh, Rikhiya and von Stockhausen, Hans-Martin and Schmitt, Martin and Vasile, George Marica and Karn, Sanjeev Kumar and Farri, Oladimeji},
  booktitle={Proceedings of the AAAI Conference on Artificial Intelligence},
  volume={39},
  number={28},
  pages={28757--28765},
  year={2025},
  abstract = {The National Vulnerability Database (NVD) publishes over a thousand new vulnerabilities monthly, with a projected 25 percent increase in 2024, highlighting the crucial need for rapid vulnerability identification to mitigate cybersecurity attacks and save costs and resources. In this work, we propose using large language models (LLMs) to learn vulnerability evaluation from historical assessments of medical device vulnerabilities in a single manufacturer's portfolio. We highlight the effectiveness and challenges of using LLMs for automatic vulnerability evaluation and introduce a method to enrich historical data with cybersecurity ontologies, enabling the system to understand new vulnerabilities without retraining the LLM. Our LLM system integrates with the in-house application - Cybersecurity Management System (CSMS) - to help Siemens Healthineers (SHS) product cybersecurity experts efficiently assess the vulnerabilities in our products. Also, we present guidelines for efficient integration of LLMs into the cybersecurity tool.}
}
@misc{yang2026autoegexploitingknownthirdparty,
  title         = {{AutoEG}: Exploiting known third-party vulnerabilities in black-box web applications},
  author        = {Ruozhao Yang and Mingfei Cheng and Gelei Deng and Junjie Wang and Tianwei Zhang and Xiaofei Xie},
  mark          = {EB/OL},
  year          = {2026},
  eprint        = {2604.00704},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CR},
  urldate       = {2026-04-01},
  url           = {https://arxiv.org/abs/2604.00704},
  abstract      = {Large-scale web applications are widely deployed with complex third-party components, inheriting security risks arising from component vulnerabilities. Security assessment is therefore required to determine whether such known vulnerabilities remain practically exploitable in real applications. Penetration testing is a widely adopted approach that validates exploitability by launching concrete attacks against known vulnerabilities in real-world black-box systems. However, existing approaches often fail to automatically generate reliable exploits, limiting their effectiveness in practical security assessment. This limitation mainly stems from two issues: (1) precisely triggering vulnerabilities with correct technical details, and (2) adapting exploits to diverse real-world deployment settings. In this paper, we propose AutoEG, a fully automated multi-agent framework for exploit generation targeting black-box web applications. AutoEG has two phases: First, AutoEG extracts precise vulnerability trigger logic from unstructured vulnerability information and encapsulates it into reusable trigger functions. Second, AutoEG uses trigger functions for concrete attack objectives and iteratively refines exploits through feedback-driven interaction with the target application. We evaluate AutoEG on 104 real-world vulnerabilities with 29 attack objectives, resulting in 660 exploitation tasks and 55,440 exploit attempts. AutoEG achieves an average success rate of 82.41\%, substantially outperforming state-of-the-art baselines, whose best performance reaches only 32.88\%.}
}

